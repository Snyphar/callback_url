# ===========================================================================
# Email Generation Assistant — environment configuration
# Copy this file to `.env` and fill in the values for the provider you use.
# ===========================================================================

# ---- Provider selection -----------------------------------------------------
# Used for email GENERATION and (separately) for the LLM-as-judge METRICS.
# Options: openai | gemini | anthropic | replay
#   replay = offline, deterministic; reproduces the committed eval from recorded
#            outputs with no API key (see evaluation/replay_data.json)
GEN_PROVIDER=gemini
JUDGE_PROVIDER=gemini

# ---- Model overrides (optional) --------------------------------------------
# Leave blank to use the sensible default for each provider:
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-2.5-flash
#   anthropic -> claude-haiku-4-5-20251001
# GEN_MODEL=
# JUDGE_MODEL=

# ---- API keys (set the one(s) matching your providers) ----------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Sampling settings ------------------------------------------------------
# Low generation temperature -> more reproducible eval runs.
# Judge temperature 0.0 -> deterministic scoring.
GEN_TEMPERATURE=0.3
JUDGE_TEMPERATURE=0.0
